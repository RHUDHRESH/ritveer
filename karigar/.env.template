# KARIGAR Environment Configuration
# Copy this to .env and fill in your actual values

# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Alternative: Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Web Search (Perplexity API - Optional)
PERPLEXITY_API_KEY=pplx-your-key-here

# Database Configuration
DATABASE_URL=sqlite:///./karigar.db
# For PostgreSQL: postgresql://user:password@localhost/karigar

# Redis/Cache Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ChromaDB Vector Store
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=karigar_memory

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_secret_here

# Location Services
NOMINATIM_USER_AGENT=karigar-artisan-platform

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/karigar.log

# Feature Flags
ENABLE_WEB_SCRAPING=true
ENABLE_SUPPLIER_SEARCH=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_PDF_GENERATION=true
ENABLE_NOTIFICATIONS=true

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@karigar.local

# Timeout Settings (seconds)
LLM_TIMEOUT=60
SCRAPER_TIMEOUT=30
SUPPLIER_SEARCH_TIMEOUT=15
PDF_GENERATION_TIMEOUT=20

# Cache TTL (seconds)
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=3600
CACHE_TTL_LONG=86400

# System Configuration
MAX_WORKERS=4
MAX_CONCURRENT_REQUESTS=10
BATCH_SIZE=10
